# Conxian Gateway Configuration

# Blockchain Configuration
# URL of the Bitcoin node RPC
# Public mainnet default (free/open): https://bitcoin-rpc.publicnode.com
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com
# Bitcoin RPC user (optional; leave blank for public endpoints)
BITCOIN_RPC_USER=
# Bitcoin RPC password (optional; leave blank for public endpoints)
BITCOIN_RPC_PASS=
# Sync interval for Bitcoin in seconds
BITCOIN_SYNC_INTERVAL=10

# URL of the Stacks node API
STACKS_RPC_URL=https://api.mainnet.hiro.so
# Sync interval for Stacks in seconds
STACKS_SYNC_INTERVAL=30

# API Configuration
# Port for the Gateway API
API_PORT=3000
# Bearer token for institutional API access
API_TOKEN=institutional-default-token

# Fiat On-Ramp Configuration
# API key for Ramp Network
RAMP_API_KEY=default-ramp-key
# Client ID for Investec
INVESTEC_CLIENT_ID=default-investec-id
# Client secret for Investec
INVESTEC_SECRET=default-investec-secret
# App ID for Alchemy Pay
ALCHEMY_PAY_APP_ID=default-alchemy-id
# App secret for Alchemy Pay
ALCHEMY_PAY_SECRET=default-alchemy-secret
# API key for Banxa
BANXA_API_KEY=default-banxa-key
# API secret for Banxa
BANXA_SECRET=default-banxa-secret

# A2P Messaging Configuration
# API key for Infobip
INFOBIP_API_KEY=default-infobip-key
# Base URL for Infobip API
INFOBIP_BASE_URL=https://api.infobip.com

# Security Configuration
# Secret for HMAC-SHA256 verification (webhooks and OTP)
HMAC_SECRET=default-hmac-secret

# Secret for fiat webhook HMAC verification
FIAT_WEBHOOK_SECRET=CHANGEME_FIAT_WEBHOOK_SECRET

# Secret for settlement ingress HMAC verification (must be distinct from FIAT_WEBHOOK_SECRET)
SETTLEMENT_INGRESS_SECRET=CHANGEME_SETTLEMENT_INGRESS_SECRET
