# Conxian Gateway Configuration

# Blockchain Configuration
# URL of the Bitcoin node RPC
# Public mainnet default (free/open): https://bitcoin-rpc.publicnode.com
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com
# Bitcoin RPC user (optional; set both user+pass, or leave both blank)
BITCOIN_RPC_USER=
# Bitcoin RPC password (optional; set both user+pass, or leave both blank)
BITCOIN_RPC_PASS=
# Sync interval for Bitcoin in seconds
BITCOIN_SYNC_INTERVAL=10

# Optional Babylon REST API base URL for BTC header-chain verification.
# Leave blank to fail explicitly when Babylon header data is requested.
BABYLON_API_URL=

# Mempool orchestrator settings (CON-718)
# Poll interval in seconds for evaluating pending transactions
MEMPOOL_ORCHESTRATOR_INTERVAL=30
# Age threshold before a pending tx is classified as stuck
MEMPOOL_STUCK_THRESHOLD_SECS=300
# Maximum number of fee bump attempts per tracked tx
MEMPOOL_MAX_FEE_BUMP_ATTEMPTS=3
# Upper fee cap enforced for RBF/CPFP bump decisions
MEMPOOL_MAX_FEE_RATE_SAT_VB=150
# Minimum increment (sat/vB) required for each bump decision
MEMPOOL_MIN_BUMP_INCREMENT_SAT_VB=2

# RGB adapter configuration (issue #228, Phase 1.5)
# disabled: no RGB calls; shadow: simulation fallback is allowed; active:
# fail-closed on unknown contracts and native/HTTP verification failures.
RGB_MODE=disabled
# RGB node endpoint. Plain HTTP is accepted only for localhost/loopback.
RGB_NODE_URL=http://localhost:8080
# Optional native stash metadata path. Configure together with RGB_ESPLORA_URL
# when using Active mode with the rgb-native feature.
RGB_STASH_PATH=
# Optional Esplora endpoint for native UTXO resolution. Do not embed credentials.
RGB_ESPLORA_URL=

# URL of the Stacks node API
STACKS_RPC_URL=https://api.mainnet.hiro.so
# Sync interval for Stacks in seconds
STACKS_SYNC_INTERVAL=30

# API Configuration
# Port for the Gateway API
API_PORT=3000
# Bearer token for institutional API access (Mandatory in production)
API_TOKEN=sentinel_API_TOKEN

# Fiat On-Ramp Configuration (Mandatory in production)
RAMP_API_KEY=sentinel_RAMP_API_KEY
INVESTEC_CLIENT_ID=sentinel_INVESTEC_CLIENT_ID
INVESTEC_SECRET=sentinel_INVESTEC_SECRET
ALCHEMY_PAY_APP_ID=sentinel_ALCHEMY_PAY_APP_ID
ALCHEMY_PAY_SECRET=sentinel_ALCHEMY_PAY_SECRET
BANXA_API_KEY=sentinel_BANXA_API_KEY
BANXA_SECRET=sentinel_BANXA_SECRET

# A2P Messaging Configuration (Mandatory in production)
INFOBIP_API_KEY=sentinel_INFOBIP_API_KEY
INFOBIP_BASE_URL=https://api.infobip.com

# Security Configuration
# Secret for HMAC-SHA256 verification (webhooks and OTP)
HMAC_SECRET=sentinel_HMAC_SECRET

# Secret for fiat webhook HMAC verification
FIAT_WEBHOOK_SECRET=sentinel_FIAT_WEBHOOK_SECRET

# Secret for settlement ingress HMAC verification (must be distinct from FIAT_WEBHOOK_SECRET)
SETTLEMENT_INGRESS_SECRET=sentinel_SETTLEMENT_INGRESS_SECRET

# Oracle public key for DLC bond orchestration
ORACLE_PUBKEY=sentinel_ORACLE_PUBKEY

# Secret for offline queue encryption (32-byte hex or long string)
OFFLINE_QUEUE_SECRET=sentinel_OFFLINE_QUEUE_SECRET
